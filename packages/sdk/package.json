{
  "name": "@quest/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Quest program client: IDL, PDAs and instruction builders shared by web and api",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "sync-idl": "cp ../../contracts/target/idl/quest.json src/idl/quest.json && cp ../../contracts/target/types/quest.ts src/idl/quest.ts",
    "typecheck": "tsc --noEmit",
    "init-devnet": "tsx scripts/init-devnet.ts",
    "init-mainnet": "tsx scripts/init-mainnet.ts",
    "smoke-devnet": "tsx scripts/smoke-devnet.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "tsx": "^4.7.0"
  },
  "type": "module"
}
