    "@solana/web3.js": "^1.91.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.30.0",
    "hono": "^4.4.0",
    "jose": "^5.2.0",
    "nanoid": "^5.0.0",
    "openai": "^4.40.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "drizzle-kit": "^0.21.0",
    "tsx": "^4.23.15",
